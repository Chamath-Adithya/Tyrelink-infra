[Unit]
Description=Tyrelink Go API
After=network.target postgresql.service

[Service]
User=tyrelink
WorkingDirectory=/srv/tyrelink/api
EnvironmentFile=/etc/tyrelink/api.env
ExecStart=/srv/tyrelink/api/tyrelink-api
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tyrelink

[Install]
WantedBy=multi-user.target
